<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>XRay.ThreeD</AssemblyName>
    <RootNamespace>XRay.ThreeD</RootNamespace>
    <Description>Dependency-free .NET library for 3D and CAD files: identifies the format, extracts metadata (part and assembly names, layers, units, properties, component references, previews) and converts the geometry to binary glTF (.glb) for browsers. Readers for SolidWorks, STL, OBJ, PLY, glTF/GLB and 3MF. Part of the X-Ray family.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>X-Ray.3D</PackageId>
    <PackageTags>3d;cad;solidworks;stl;obj;ply;gltf;glb;3mf;metadata;x-ray</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/curiosity-ai/x-ray-others/tree/main/XRay.3D</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XRay.ThreeD.Tests" />
  </ItemGroup>
</Project>
