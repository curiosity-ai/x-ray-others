<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit1051: the library calls take an optional CancellationToken; the existing tests exercise the token-less forms on purpose, and CancellationTests covers the token. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Native Skia for the test host; applications pick their own platform asset. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XRay.Psd.Skia/XRay.Psd.Skia.csproj" />
    <Compile Include="../XRay.Psd.Tests/Support/Fixtures.cs" Link="Support/Fixtures.cs" />
  </ItemGroup>
</Project>
